{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostUid', 'status', 'roundIndex', 'roundKey', 'questionOrder', 'deadline', 'createdAt'])",
          "hostUid": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'answering' || newData.val() === 'reveal' || newData.val() === 'finished' || newData.val() === 'resetting' || newData.val() === 'resolving')"
          },
          "roundIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "roundKey": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,6}$/)"
          },
          "questionOrder": {
            ".validate": "newData.hasChildren(['0', '1', '2', '3', '4']) && newData.child('0').isString() && newData.child('1').isString() && newData.child('2').isString() && newData.child('3').isString() && newData.child('4').isString()",
            "$index": {
              ".validate": "($index === '0' || $index === '1' || $index === '2' || $index === '3' || $index === '4' || $index === '5' || $index === '6' || $index === '7' || $index === '8' || $index === '9' || $index === '10' || $index === '11' || $index === '12' || $index === '13' || $index === '14') && newData.isString()"
            }
          },
          "deadline": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "questionCount": {
            ".validate": "newData.isNumber() && (newData.val() === 5 || newData.val() === 10 || newData.val() === 15)"
          },
          "selectedCategory": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "selectedLevel": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "selectedPeriod": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "mode": {
            ".validate": "newData.isString() && (newData.val() === 'standard' || newData.val() === 'survival')"
          },
          "initialHp": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
          },
          "survivalHp": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            }
          },
          "survivedRounds": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            }
          },
          "lastDamage": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            }
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').exists() && (root.child('rooms').child($room).child('meta').child('status').val() === 'lobby' || root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' || (auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resolving') || data.exists())",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },
        "answers": {
          "$round": {
            ".read": "auth != null && (auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() || root.child('rooms').child($room).child('meta').child('status').val() !== 'answering')",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && $round === root.child('rooms').child($room).child('meta').child('roundKey').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'answering' && now < root.child('rooms').child($room).child('meta').child('deadline').val() && root.child('rooms').child($room).child('players').child($uid).exists()",
              ".validate": "newData.hasChildren(['year']) && (newData.hasChild('month') === newData.hasChild('day'))",
              "year": {
                ".validate": "newData.isNumber() && newData.val() >= -1999 && newData.val() <= 9999"
              },
              "$other": {
                ".validate": false
              },
              "month": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
              },
              "day": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
              }
            }
          },
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()"
        }
      }
    }
  }
}
