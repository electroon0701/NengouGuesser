                ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2)"
              }
            }
          },
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()"
        },
        "videoEnded": {
          "$round": {
            ".read": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val()",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($room).child('meta').child('status').val() === 'reveal' || root.child('rooms').child($room).child('meta').child('status').val() === 'celebrating') && $round === root.child('rooms').child($room).child('meta').child('roundKey').val()",
              ".validate": "newData.isBoolean() && newData.val() === true"
            }
          },
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()"
        },
        "challengeProgress": {
          ".read": "auth != null && (auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() || root.child('rooms').child($room).child('meta').child('status').val() === 'finished')",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('meta').child('status').val() === 'finished')",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').child('mode').val() === 'senjin' && root.child('rooms').child($room).child('players').child($uid).exists() && ((root.child('rooms').child($room).child('meta').child('status').val() === 'answering' && ((!data.exists() && now < root.child('rooms').child($room).child('meta').child('deadline').val()) || (data.exists() && now < data.child('personalDeadline').val()) || (data.exists() && newData.child('done').val() === true && now >= data.child('personalDeadline').val() && newData.child('questionIndex').val() === data.child('questionIndex').val() && newData.child('score').val() === data.child('score').val() && newData.child('correctCount').val() === data.child('correctCount').val() && newData.child('wrongCount').val() === data.child('wrongCount').val())) || (root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && !newData.exists())))",
            ".validate": "newData.hasChildren(['questionIndex', 'score', 'correctCount', 'wrongCount', 'personalDeadline', 'extensionMs', 'done'])",
            "questionIndex": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
            },
            "correctCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "wrongCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "$other": {
              ".validate": false
            },
            "personalDeadline": {
              ".validate": "newData.isNumber() && newData.val() >= root.child('rooms').child($room).child('meta').child('deadline').val() && newData.val() <= root.child('rooms').child($room).child('meta').child('deadline').val() + root.child('rooms').child($room).child('meta').child('challengeDurationSeconds').val() * 1000 && (!data.exists() || newData.val() >= data.val())"
            },
            "extensionMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('rooms').child($room).child('meta').child('challengeDurationSeconds').val() * 1000 && (!data.exists() || newData.val() >= data.val())"
            },
            "lastExtensionMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23500"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "lastPrecisionLevel": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            }
          },
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()"
        },
        "challengeAnswers": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('meta').child('status').val() === 'finished')",
            "$index": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').child('mode').val() === 'senjin' && root.child('rooms').child($room).child('meta').child('status').val() === 'answering' && now < root.child('rooms').child($room).child('challengeProgress').child($uid).child('personalDeadline').val() && root.child('rooms').child($room).child('challengeProgress').child($uid).child('done').val() === false && root.child('rooms').child($room).child('players').child($uid).exists()",
              ".validate": "$index.matches(/^(0|[1-9][0-9]{0,5})$/) && newData.hasChildren(['year', 'score', 'correct']) && (newData.hasChild('month') === newData.hasChild('day'))",
              "year": {
                ".validate": "newData.isNumber() && newData.val() >= -1999 && newData.val() <= 9999"
              },
              "month": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
              },
              "day": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 3000"
              },
              "correct": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              },
              "precisionLevel": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "extensionMs": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23500"
              },
              "scoreMultiplier": {
                ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2)"
              }
            }
          },
          ".read": "auth != null && root.child('rooms').child($room).child('meta').child('status').val() === 'finished'",
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()"
        },
        "itemState": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').child('status').val() === 'answering' && (root.child('rooms').child($room).child('meta').child('participantRoster').child($uid).exists() || root.child('rooms').child($room).child('players').child($uid).exists()) || auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()",
            ".validate": "newData.hasChildren(['items'])",
