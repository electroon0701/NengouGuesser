            }
          },
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()"
        }
      }
    },
    "stats": {
      "ssUsers": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === true",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    }
  }
}
