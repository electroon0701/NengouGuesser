                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').child('status').val() === 'targeting' && now < root.child('rooms').child($room).child('meta').child('targetDeadline').val() && data.parent().exists()",
                ".validate": "newData.isString() && root.child('rooms').child($room).child('players').child(newData.val()).exists()"
              },
