{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostUid', 'status', 'roundIndex', 'roundKey', 'questionOrder', 'deadline', 'createdAt'])",
          "hostUid": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'answering' || newData.val() === 'targeting' || newData.val() === 'celebrating' || newData.val() === 'reveal' || newData.val() === 'finished' || newData.val() === 'resetting' || newData.val() === 'resolving')",
            ".write": "auth != null && newData.val() === 'finished' && data.val() === 'answering' && root.child('rooms').child($room).child('meta').child('mode').val() === 'senjin' && now >= root.child('rooms').child($room).child('meta').child('deadline').val() && root.child('rooms').child($room).child('players').child(auth.uid).exists()"
          },
          "roundIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "roundKey": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,6}$/)"
          },
          "questionOrder": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]{0,3})$/) && newData.isString()"
            }
          },
          "deadline": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "targetDeadline": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "questionCount": {
            ".validate": "newData.isNumber() && (newData.val() === 5 || newData.val() === 10 || newData.val() === 15)"
          },
          "selectedCategory": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "selectedLevel": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "selectedPeriod": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "selectedCategories": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            }
          },
          "selectedLevels": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            }
          },
          "selectedPeriods": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            }
          },
          "mode": {
            ".validate": "newData.isString() && (newData.val() === 'standard' || newData.val() === 'survival' || newData.val() === 'senjin' || newData.val() === 'half_individual' || newData.val() === 'half_team')"
          },
          "damageDifficulty": {
            ".validate": "newData.isString() && (newData.val() === 'easy' || newData.val() === 'normal' || newData.val() === 'hard' || newData.val() === 'hell')"
          },
          "initialHp": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
          },
          "survivalHp": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            }
          },
          "survivedRounds": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            }
          },
          "lastDamage": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            }
          },
          "lastBonusDamage": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            }
          },
          "challengeMinutes": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1440"
          },
          "challengeDurationSeconds": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 3599"
          },
          "senjinSeed": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4294967295"
          },
          "startedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "lastHealing": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            }
          },
          "survivalRoster": {
            "$uid": {
              ".validate": "newData.hasChildren(['name','joinedAt'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
              "joinedAt": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          },
          "participantRoster": {
            "$uid": {
              ".validate": "newData.hasChildren(['name','joinedAt'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
