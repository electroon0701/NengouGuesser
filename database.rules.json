                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          },
          "itemCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
          },
          "itemModes": {
            ".validate": "newData.hasChildren()",
            "$item": {
              ".validate": "($item === 'radar' || $item === 'tailwind' || $item === 'oracle' || $item === 'century') && (newData.val() === 'manual' || newData.val() === 'auto')"
            },
            "$other": {
              ".validate": false
            }
          },
          "halfTurnIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
