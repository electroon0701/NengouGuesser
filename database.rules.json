        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').exists() && (root.child('rooms').child($room).child('meta').child('status').val() === 'lobby' || root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' || (auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && (root.child('rooms').child($room).child('meta').child('status').val() === 'resolving' || root.child('rooms').child($room).child('meta').child('status').val() === 'targeting')) || data.exists() || ((root.child('rooms').child($room).child('meta').child('status').val() === 'answering' || root.child('rooms').child($room).child('meta').child('status').val() === 'targeting' || root.child('rooms').child($room).child('meta').child('status').val() === 'celebrating' || root.child('rooms').child($room).child('meta').child('status').val() === 'reveal' || root.child('rooms').child($room).child('meta').child('status').val() === 'resolving') && root.child('rooms').child($room).child('meta').child('participantRoster').child($uid).exists()))",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },
        "answers": {
          "$round": {
            ".read": "auth != null && (auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() || root.child('rooms').child($room).child('meta').child('status').val() !== 'answering')",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && $round === root.child('rooms').child($room).child('meta').child('roundKey').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'answering' && now < root.child('rooms').child($room).child('meta').child('deadline').val() + 6000 && (root.child('rooms').child($room).child('players').child($uid).exists() || root.child('rooms').child($room).child('meta').child('participantRoster').child($uid).exists())",
              ".validate": "newData.hasChildren(['year']) && (newData.hasChild('month') === newData.hasChild('day'))",
