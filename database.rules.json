            "attemptsByQuestion": {
              ".validate": "newData.isString() && newData.val().length <= 256"
            }
          },
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('meta').child('hostUid').val() && root.child('rooms').child($room).child('meta').child('status').val() === 'resetting' && !newData.exists()"
        },
        "halfPublic": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').child('mode').val() === 'half_individual' && root.child('rooms').child($room).child('meta').child('status').val() === 'answering' && root.child('rooms').child($room).child('meta').child('participantRoster').child($uid).exists()",
            ".validate": "newData.hasChildren(['questionIndex','totalAttempts','done','startedAt','finishedAt'])",
            "questionIndex": {
