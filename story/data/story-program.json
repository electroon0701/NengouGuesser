      "areaId": "shinden"
    },
    {
      "id": "scenario_3d83c5defcba",
      "title": "この世界とは。",
      "regionId": "mesopotamia",
      "areaId": "",
      "stageId": "mesopotamia_ur",
      "era": "古代",
      "order": 2,
      "description": "",
      "sequence": [
        {
          "id": "event_6fb2585f3029",
          "type": "dialogue",
          "title": "",
          "mode": "visual_novel",
          "required": true,
          "backgroundPath": "story/assets/mesomeso.png",
          "cast": [
            {
              "characterId": "story_npc_742d037a13",
              "slot": "center",
              "portraitPath": "",
              "entranceAnimation": "fade",
              "exitAnimation": "fade",
              "expression": ""
            },
            {
              "characterId": "story_npc_fd795e9d4c",
              "slot": "right",
              "portraitPath": "",
              "entranceAnimation": "fade",
              "exitAnimation": "fade",
              "expression": ""
            }
          ],
          "lines": [
            {
              "speakerId": "",
              "text": "彼女は、そこにいた。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...おや。流石にそれくらいの能はあったか。",
              "animation": "none",
              "expression": "smug",
              "castActions": {
                "story_npc_742d037a13": {
                  "position": "enter"
                }
              },
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "いやいや、失礼。別に侮辱するつもりはない。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "さて...。まずは説明を――",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "彼女が、そう言いかけた途端。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_fd795e9d4c",
              "text": "くぎゃ〜っ！！",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "悲鳴が、こだました。彼女はそちらを素早く見やる。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "すると、近辺の砂漠の中から――猛ダッシュで、一つの影が近づいてくるのが見えた。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_fd795e9d4c",
              "text": "くそ...なんだあいつ...くそ...！！",
              "animation": "none",
              "expression": "neutral",
              "castActions": {
                "story_npc_742d037a13": {
                  "position": "left"
                },
                "story_npc_fd795e9d4c": {
                  "position": "enter"
                }
              },
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...なんてタイミングだろうな。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_fd795e9d4c",
              "text": "お、お前ら！！お前らもあいつの仲間か！？",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "コッテコテの展開だな。...まあ嫌いじゃないが。",
              "animation": "none",
              "expression": "smug",
              "choices": []
            },
            {
              "speakerId": "story_npc_fd795e9d4c",
              "text": "くそっ.....オラァあああああああ！！！！！！！！",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            }
          ],
          "media": {
            "type": "image",
            "src": "",
            "caption": ""
          },
          "speakerFocusMode": "dim"
        },
