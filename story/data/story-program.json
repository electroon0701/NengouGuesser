      "description": "",
      "sequence": [
        {
          "id": "event_5d15b46fc540",
          "type": "dialogue",
          "title": "連絡。",
          "mode": "chat",
          "required": true,
          "backgroundPath": "",
          "cast": [],
          "lines": [
            {
              "speakerId": "story_npc_742d037a13",
              "text": "やあ、元気にやってるかな。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "彼女は来ないのかと問うた。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "私は君が思う以上に重役なのだよ、下手に外には出られない。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "ビビってるのかと問うた。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...今すぐにお前を消してもいいんだからな。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "とにかく、続行してくれ。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "やはりやはり、あの騒ぎようは...ただ事とは考えられん。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "チャットを出て、進むことにした。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            }
          ],
          "media": {
            "type": "image",
            "src": "",
            "caption": ""
          }
