        {
          "id": "event_6128b0b7b4b1",
          "type": "dialogue",
          "title": "戦闘後の交流",
          "mode": "visual_novel",
          "required": true,
          "backgroundPath": "story/assets//mesomeso.png",
          "cast": [
            {
              "characterId": "story_npc_742d037a13",
