  "scenarios": [
    {
      "id": "scenario_fa79f7ca68c8",
      "title": "チュートリアル",
      "regionId": "",
      "stageId": "special_stage_4ada50c8dd",
      "era": "時代をまたぐ",
      "order": 1,
      "description": "ようこそ、「この世界」へ。",
      "sequence": [
        {
          "id": "event_635fc391c657",
          "type": "dialogue",
          "title": "『没入』",
          "mode": "visual_novel",
          "required": true,
          "backgroundPath": "story/assets/camp.png",
          "cast": [
            {
              "characterId": "story_npc_742d037a13",
              "slot": "center",
              "portraitPath": "",
              "entranceAnimation": "fade",
              "exitAnimation": "fade",
              "expression": ""
            }
          ],
          "lines": [
            {
              "speakerId": "",
              "text": "暖炉に火が灯っている。\n",
              "animation": "none",
              "expression": "neutral",
              "choices": [
                {
                  "id": "choice_be0088a67b80",
                  "label": "",
                  "responseSpeakerId": "",
                  "responseText": "",
                  "nextLineIndex": ""
                }
              ],
              "castActions": {}
            },
            {
              "speakerId": "",
              "text": "その煌々とした灯りが、その赤く染められた――北欧風の室内を照らしていた。",
              "animation": "none",
              "expression": "neutral",
              "choices": [
                {
                  "id": "choice_265ee73ea0ba",
                  "label": "",
                  "responseSpeakerId": "",
                  "responseText": "",
                  "nextLineIndex": ""
                }
              ]
            },
            {
              "speakerId": "",
              "text": "周囲を、少し見回す。すると。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "............。",
              "animation": "none",
              "expression": "neutral",
              "castActions": {
                "story_npc_742d037a13": {
                  "position": "enter"
                }
              },
              "choices": []
            },
            {
              "speakerId": "",
              "text": "『其奴』は、そこにいた。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...ふむ。来たか。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "彼女は、部屋の中にいる私を見ると、酒瓶を口から離した。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...気分はどうだ？",
              "animation": "none",
              "expression": "neutral",
              "choices": [
                {
                  "id": "choice_13d232dd304c",
                  "label": "「すこぶる良いです。」",
                  "responseSpeakerId": "story_npc_742d037a13",
                  "responseText": "...本当にか？",
                  "nextLineIndex": ""
                },
                {
                  "id": "choice_ff6ddb35ac31",
                  "label": "「最悪です。」",
                  "responseSpeakerId": "story_npc_742d037a13",
                  "responseText": "...本当にか？",
                  "nextLineIndex": ""
                }
              ]
            },
            {
              "speakerId": "",
              "text": "自分の返答に、彼女は疑問げな視線を私に向けた。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "しかしまあいい、と言った風に肩をすくめると、彼女は目を細めて問うた。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...お前、『名前』は？",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "正直に告げる。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...{{player}}か。そうか。",
              "animation": "none",
              "expression": "troubled",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "彼女はすると、少し空中に目線を離す。何か考えているようだ。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "そしてから、彼女は小さくため息をつくと、くるっと首を回した。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...記憶は...当然、飛んでいるよな。お前、私がわかるか？",
              "animation": "none",
              "expression": "neutral",
              "choices": [
                {
                  "id": "choice_150528e16a5b",
                  "label": "「わかります。」",
                  "responseSpeakerId": "story_npc_742d037a13",
                  "responseText": "嘘つけ。",
                  "nextLineIndex": ""
                },
                {
                  "id": "choice_65d8385f6daf",
                  "label": "「わかりません。」",
                  "responseSpeakerId": "story_npc_742d037a13",
                  "responseText": "正直でよろしい。",
                  "nextLineIndex": ""
                }
              ]
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...説明は...後でしよう。動きながらの方が良いし...",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...何より、長いチュートリアルよりクソだるいものもないだろう。",
              "animation": "none",
              "expression": "smug",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "「世界地図」を開き...メソポタミアを選べ。「ウル」が解放されているはずだ。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "じゃあな。それくらいはできると思ってるぞ。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "彼女はそういうと、その部屋をスタスタと立ち去っていった。",
              "animation": "none",
              "expression": "neutral",
              "castActions": {
                "story_npc_742d037a13": {
                  "position": "exit"
                }
              },
              "choices": []
            },
            {
              "speakerId": "",
              "text": "――その部屋には、ツンと鼻をつくアルコールの匂いだけが残った。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            }
          ],
          "media": {
            "type": "image",
            "src": "",
            "caption": ""
          },
          "speakerFocusMode": "dim"
        }
      ],
      "nextScenarioIds": [
        "scenario_3d83c5defcba"
      ],
      "rewardEdone": 0,
      "rewardUnlockRegionIds": [
        "mesopotamia"
      ],
      "rewardUnlockStageIds": [
        "mesopotamia_ur"
      ],
