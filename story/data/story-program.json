              "portraitPath": "",
              "entranceAnimation": "fade",
              "exitAnimation": "fade",
              "expression": ""
            }
          ],
          "lines": [
            {
              "speakerId": "story_npc_fd795e9d4c",
              "text": "ぐぎゃあああ！！！！",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "その騒がしいやつは、そう大きな断末魔とともに消えていった。",
              "animation": "none",
              "expression": "neutral",
              "castActions": {
                "story_npc_fd795e9d4c": {
                  "position": "exit"
                }
              },
              "choices": []
            },
            {
              "speakerId": "",
              "text": "そう。『消えていった』。",
              "animation": "none",
              "expression": "neutral",
              "castActions": {
                "story_npc_742d037a13": {
                  "position": "center"
                }
              },
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "あれ程度の『編輯』で消し飛ぶとは。...相当に力のない職員だったんだろう。",
              "animation": "none",
              "expression": "neutral",
              "choices": [
                {
                  "id": "choice_4f8128466d5b",
                  "label": "「職員？」",
                  "responseSpeakerId": "",
                  "responseText": "...まぁ、そうだな。歴史を改竄して甘い汁を吸おうとする連中だ。",
                  "nextLineIndex": ""
                }
              ]
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "ちなみに言うと、『編輯』は歴史を「確認」する行為だ。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "あいつらは何度も歴史に侵入している。...だから「正史」を出されると、彼らの存在は因果律的に消し飛ぶんだ。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "...まぁ、詳しいことはわからなくていい。とにかく、ああ言う奴らをお前は懲らしめられる、と言うことだ。",
              "animation": "none",
              "expression": "smug",
              "choices": []
            },
            {
              "speakerId": "story_npc_742d037a13",
              "text": "....しかし、一体あやつは何に驚いていたんだか......",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            },
            {
              "speakerId": "",
              "text": "彼女はそう言って、その眩しいばかりの空と黄色い大地の果てを、見遣った。",
              "animation": "none",
              "expression": "neutral",
              "choices": []
            }
          ],
          "media": {
            "type": "image",
            "src": "",
            "caption": ""
          },
